; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lahi"
config/description="Virtualizacion de laboratorio autocontenido hidroponico de industria 4.0.
Permite la visualizacion de estado en tiempo real, datos y control remoto del sistema."
run/main_scene="uid://dp5w7hcf00ryq"
config/features=PackedStringArray("4.6", "Mobile")
run/max_fps=60
config/icon="uid://bbjs5epms58l2"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=648
window/size/window_height_override=1152
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[file_customization]

folder_colors={
"res://android/": "red",
"res://assets/": "orange",
"res://assets/3d/": "orange",
"res://assets/images/": "orange",
"res://resources/": "yellow",
"res://scenes/": "green",
"res://scripts/": "teal"
}

[filesystem]

import/blender/enabled=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
