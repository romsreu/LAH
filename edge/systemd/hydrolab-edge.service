[Unit]
Description=LAHI 4.0 - Bridge Arduino a InfluxDB Cloud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=romsreu

# Ajustá estas rutas si clonás el repo en otro lado.
WorkingDirectory=/home/romsreu/hydrolab/edge
EnvironmentFile=/home/romsreu/hydrolab/edge/config/.env
ExecStart=/usr/bin/python3 src/main.py

# src/ tiene que estar en el PYTHONPATH para que los imports entre módulos
# (import config, import buffer) resuelvan.
Environment=PYTHONPATH=/home/romsreu/hydrolab/edge/src
Environment=PYTHONUNBUFFERED=1

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
