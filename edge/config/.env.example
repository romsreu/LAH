# LAHI 4.0 / edge — configuración
#
# Copiá este archivo a config/.env y completá los valores reales.
# config/.env está en .gitignore: NO se versiona, no metas el token acá.
#
# Formato systemd EnvironmentFile: sin "export", sin comillas, sin espacios
# alrededor del "=". Eso vale también cuando lo lee python-dotenv.

# ── InfluxDB Cloud ───────────────────────────────────────────────────────────
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_TOKEN=pegar_el_token_aca
INFLUX_ORG=romsreu
INFLUX_BUCKET=hydrolab

# Proxy saliente. La red de la facultad bloquea el 443 directo.
# Dejalo vacío para conexión directa (por ejemplo con hotspot).
# Formato: http://HOST:PUERTO   o   http://usuario:password@HOST:PUERTO
INFLUX_PROXY=

# ── Puerto serie ─────────────────────────────────────────────────────────────
# Vacío = autodetectar (busca ttyACM* o ttyUSB*).
# Poné /dev/ttyACM0 para forzar uno fijo.
SERIAL_PORT=
SERIAL_BAUD=9600

# ── Ciclo ────────────────────────────────────────────────────────────────────
INTERVALO_SEGUNDOS=300

# ── Compatibilidad con el firmware ───────────────────────────────────────────
# El firmware actual manda el typo "iniferior". Si lo corregís en
# json_serial.cpp, cambiá esto a led_estante_inferior_estado.
CAMPO_LED_INFERIOR=led_estante_iniferior_estado
